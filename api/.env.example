# Copy to .env and adjust paths as needed.
# Same keys work later with Supabase Postgres URL.

DATABASE_URL=sqlite:///./data/lead_feed.db

# Telethon (copy session from telegram-parser; never commit .env or *.session)
TG_API_ID=
TG_API_HASH=
TG_SESSION=tg_session

# Sync tuning
SYNC_BACKFILL_LIMIT=5
SYNC_CHANNEL_PAUSE_SECONDS=1.0
